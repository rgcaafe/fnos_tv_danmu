<?xml version="1.0" encoding="utf-8"?>
<!--
  播放器（与首页/详情同一套语言）：
  纯黑底 + 顶部/底部渐变遮罩 + 半透明玻璃控件 + 白色主按钮。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 视频 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 弹幕层 -->
    <com.fntv.app.DanmuView
        android:id="@+id/danmuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 缓冲 -->
    <TextView
        android:id="@+id/tvBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/bg_danmu_status"
        android:text="加载中…"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 顶部 / 底部渐变遮罩 -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_scrim_top" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_scrim_bottom" />

    <!-- 顶部：返回 + 标题 + 弹幕匹配 / 直链 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="14dp"
        android:visibility="invisible">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_player_circle"
            android:contentDescription="返回"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:nextFocusDown="@+id/btnDanmu"
            app:srcCompat="@drawable/ic_chevron_left" />

        <LinearLayout
            android:id="@+id/titleBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDanmuMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloudMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_player_quality"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="220dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:text="直链"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            android:nextFocusUp="@+id/btnLock"
            android:nextFocusDown="@+id/btnBack" />
    </LinearLayout>

    <!-- 弹幕状态提示 -->
    <TextView
        android:id="@+id/tvDanmuStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_danmu_status"
        android:ellipsize="end"
        android:maxLines="3"
        android:maxWidth="420dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 长按倍速提示 -->
    <TextView
        android:id="@+id/tvSpeedHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_danmu_status"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="倍速播放中"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 弹幕开关（左侧） -->
    <Button
        android:id="@+id/btnDanmu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="14dp"
        android:background="@drawable/bg_player_circle"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="弹"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="invisible"
        android:nextFocusDown="@+id/seekBar" />

    <!-- 锁定按钮（右侧） -->
    <ImageView
        android:id="@+id/btnLock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="14dp"
        android:background="@drawable/bg_player_circle"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_unlock"
        android:visibility="invisible"
        android:nextFocusDown="@+id/btnInfo" />

    <!-- 控制层 -->
    <LinearLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="invisible">

        <!-- 进度条 -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/seekbar_bg_focus"
            android:focusable="true"
            android:max="1000"
            android:nextFocusDown="@+id/btnPlayPause"
            android:nextFocusUp="@+id/btnDanmu"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="6dp"
            android:progress="0"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/seeker_progress"
            android:thumb="@drawable/seeker_thumb" />

        <!-- 时间 -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="2dp"
            android:letterSpacing="0.04"
            android:text="00:00 / 00:00"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 播放控制 -->
            <LinearLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_player_ctl"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="104dp"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:nextFocusUp="@+id/seekBar">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPlayPause"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_pause" />

                <TextView
                    android:id="@+id/tvPlayPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:includeFontPadding="false"
                    android:text="播放"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRewind"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="↺ 10"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="↻ 10"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="1x"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRatio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="比例"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEpisodeList"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="选集"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextEp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="下一集"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="片头尾"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="信息"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:nextFocusRight="@+id/btnQuality"
                android:nextFocusUp="@+id/btnLock" />

            <Button
                android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="画质"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:nextFocusLeft="@+id/btnInfo"
                android:nextFocusRight="@+id/btnBrightness" />

            <Button
                android:id="@+id/btnBrightness"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_player_ctl"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="亮度"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 信息面板 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_sheet"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/infoTextAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoTextExtra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text=""
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/trackBtnRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAudioTrack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_player_dialog_chip"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="音轨"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:nextFocusDown="@+id/btnCloseInfo" />

            <Button
                android:id="@+id/btnSubtitleTrack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_player_dialog_chip"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="字幕"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:nextFocusDown="@+id/btnHdrToggle" />

            <Button
                android:id="@+id/btnHdrToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_player_dialog_chip"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="HDR"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:nextFocusDown="@+id/btnCloseInfo" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseInfo"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_player_primary"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="关闭"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:nextFocusUp="@+id/btnSubtitleTrack" />
    </LinearLayout>

</FrameLayout>
