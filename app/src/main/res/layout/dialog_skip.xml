<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_skip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="片头片尾跳过"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <include layout="@layout/item_danmu_slider"
        android:id="@+id/dm_intro" />

    <include layout="@layout/item_danmu_slider"
        android:id="@+id/dm_outro" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/dm_reset"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_player_dialog_chip"
            android:backgroundTint="@null"
            android:text="重置"
            android:textColor="#CCCCCC"
            android:focusable="true" />

        <Button
            android:id="@+id/dm_cancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_player_dialog_chip"
            android:backgroundTint="@null"
            android:text="取消"
            android:textColor="#CCCCCC"
            android:focusable="true" />

        <Button
            android:id="@+id/dm_ok"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_primary"
            android:backgroundTint="@null"
            android:text="确定"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
